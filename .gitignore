# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large or reproducible raw data (re-acquire with src/acquisition scripts)
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Large processed intermediates (compact outputs in data/processed are tracked)
data/processed/**/*.large.*
*.gpkg-journal
*.tmp

# Scenario load outputs: track only the core set (trend ownership county profiles for all charging scenarios,
# trend/base site, parcel and BG outputs); the full scenario grid is reproducible via src.model.load_assembly
data/processed/load/county_hourly_*_slow_*.parquet
data/processed/load/county_hourly_*_stall_*.parquet
data/processed/load/county_hourly_*_policy_*.parquet
data/processed/load/site_summary_*_slow_*.csv
data/processed/load/site_summary_*_stall_*.csv
data/processed/load/site_summary_*_policy_*.csv
data/processed/load/site_summary_*_trend_access+.csv
data/processed/load/site_summary_*_trend_managed.csv

# Presentation decks: built artifacts are not version-controlled (generator in src/deck/, style in docs/style/)
results/deck/
src/deck/node_modules/
*.pptx
