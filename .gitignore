# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large or reproducible raw data (re-acquire with src/acquisition scripts)
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Large processed intermediates (compact outputs in data/processed are tracked)
data/processed/**/*.large.*
*.gpkg-journal
*.tmp
